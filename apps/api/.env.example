# CineMind API configuration. Copy to apps/api/.env and fill in the secrets.
# .env is git-ignored. NEVER commit real values.

PORT=4000

# Runtime PostgreSQL login: the restricted cinemind_app role (NOT the postgres superuser).
# database/setup.ps1 sets this role's password from DB_PASSWORD below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinemind_db
DB_USER=cinemind_app
DB_PASSWORD=replace-with-a-long-random-password

# Secret for signing JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000
